# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Data artifacts (local dev DB / generated telemetry / generated demo plan /
# generated dashboard -- all timestamp-calibrated to whatever's currently in
# storage, so committed copies would look stale immediately; regenerate with
# scripts/generate_demo_augment_plan.py and src.alerting.pipeline instead)
data/*.sqlite
data/*.parquet
data/augment_pipeline.csv
data/dashboard.html
!data/.gitkeep

# Local-only session artifacts (not meant to be pushed)
docs/*.pdf

# Docker
.env

# OS/editor
.DS_Store
.vscode/
.idea/
.pytest_cache/
